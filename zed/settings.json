// Zed settings
{
    // Stuff I don't want
    "cli_default_open_behavior": "existing_window",
    "project_panel": {
        "dock": "left",
        "starts_open": false,
        "hide_root": true,
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },

    // AI AI AI
    "disable_ai": true,
    "agent": {
        "sidebar_side": "right",
        "dock": "right",
        "default_profile": "ask",
        "default_model": {
            "provider": "copilot_chat",
            "model": "claude-opus-4.6",
        },
        "favorite_models": [],
        "model_parameters": [],
    },
    "show_edit_predictions": false,
    "edit_predictions": {
        "copilot": {
            "enable_next_edit_suggestions": false,
        },
        "provider": "copilot",
    },

    // UI
    "ui_font_family": ".ZedSans",
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },

    "terminal": {
        "font_family": "CaskaydiaCove NF",
    },
    "icon_theme": {
        "mode": "dark",
        "light": "Catppuccin Frappé",
        "dark": "Base Charmed Icons",
    },
    "base_keymap": "VSCode",
    "ui_font_size": 16,
    "buffer_font_size": 15,
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Aura Dark (Soft Text)",
    },
    "theme_overrides": {
        "Catppuccin Frappé (Blur) [Heavy]": {
            // Catppuccin Frappé blur dark translucent overrides
            // Ref: https://www.reddit.com/r/ZedEditor/comments/1dw4430/comment/njl0phw/?utm_source=share&utm_medium=web3x&utm_name=web3xcss&utm_term=1&utm_content=share_button
            "status_bar.background": "#303446e0",
            "title_bar.background": "#303446e0",
            "elevated_surface.background": "#303446e0",
            "editor.line_number": "#b5bfe299",
            "editor.active_line_number": "#8caaee",
            "editor.active_line.background": "#51576d40",

            "border": "#73799440",

            "scrollbar.thumb.background": "#8caaee20",

            "ghost_element.hover": "#8caaee10",
            "ghost_element.active": "#8caaee15",
            "ghost_element.selected": "#8caaee20",
            "element.hover": "#8caaee10",
        },
        "Aura Dark (Soft Text)": {
            "editor.document_highlight.read_background": "#00000000",
            "editor.document_highlight.write_background": "#00000000",
            "border.variant": "#15141C",
            "border": "#a394f033", // Needed for Mermaid arrows
            "title_bar.background": "#15141C",
            // "panel.background": "#15141C", // Needed for Mermaid group display
            "panel.focused_border": "#4E466E",
            "players": [
                {
                    "cursor": "#BD9DFF",
                },
            ],
            "syntax": {
                "comment": {
                    "font_style": "italic",
                },
                "comment.doc": {
                    "font_style": "italic",
                },
            },
        },
    },
    "title_bar": {
        "show_onboarding_banner": false,
        "show_branch_name": false,
        "show_project_items": false,
        "show_user_menu": false,
        "show_sign_in": false,
    },
    "tab_bar": {
        "show": false,
    },

    "format_on_save": "off",
    "toolbar": {
        "breadcrumbs": true,
        "quick_actions": false,
        "selections_menu": false,
    },
    "tabs": {
        "file_icons": true,
    },
    "minimap": {
        "show": "always",
    },

    "hide_mouse": "on_typing_and_action",
    "cursor_shape": "block",
    "scrollbar": {
        "show": "never",
    },
    "gutter": {
        "min_line_number_digits": 0,
        "folds": false,
        "runnables": false,
    },

    // Tabs/Wrapping
    "indent_guides": {
        "enabled": true,
        "coloring": "indent_aware",
    },
    "tab_size": 4,
    "hard_tabs": false,
    "wrap_guides": [120],
    "soft_wrap": "editor_width",
    "remove_trailing_whitespace_on_save": true,
    "show_whitespaces": "selection",

    // Language specific
    "languages": {
        "Markdown": {
            // "show_completions_on_input": false,
            // "show_edit_predictions": false,
            // "show_completion_documentation": false
            "format_on_save": "off",
            "completions": {
                "words": "disabled",
            },
        },
        "Go": {
            "format_on_save": "on",
        },
    },
}
